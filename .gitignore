# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
src/app/favicon.ico

.vercel
.env*

# tesseract.js caches its trained data beside the process when run under Node
# (a script, not the browser, where it comes from a CDN). 5 MB, regenerable.
*.traineddata

# Scratch space for one-off API dumps during investigation.
.cache/

# The set pages scraped from TCG Collector, kept so a re-run costs them
# nothing. 67 MB of HTML that only the import scripts read, and that they
# re-fetch when it is absent — the cards and pictures extracted FROM it are
# what belongs in the repository.
data/catalog/tcgc-pages/
